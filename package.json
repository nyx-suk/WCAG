{
  "name": "wcag-accessibility-auditor",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-assisted web accessibility auditing agent",
  "scripts": {
    "fixtures": "tsx fixtures/server.ts",
    "start": "tsx src/server.ts",
    "tc1": "tsx scripts/run-tc1.ts",
    "tc2": "tsx scripts/run-tc2.ts",
    "tc3": "tsx scripts/verify-tc3-contrast.ts",
    "tc4": "tsx scripts/verify-tc4-retest.ts",
    "e2e": "tsx scripts/verify-e2e-tc2-retest.ts",
    "repeat": "tsx scripts/repeat.ts",
    "verify:tc2": "tsx scripts/verify-tc2-axe-clean.ts",
    "verify:tc3": "tsx scripts/verify-tc3-contrast.ts",
    "verify:tc4": "tsx scripts/verify-tc4-retest.ts",
    "verify:e2e": "tsx scripts/verify-e2e-tc2-retest.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "demo:reset": "tsx scripts/reset-demo-data.ts",
    "docker:build": "docker build -t wcag-accessibility-auditor .",
    "docker:run": "docker run -d -p 8080:8080 -e PORT=8080 --name wcag-auditor wcag-accessibility-auditor"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/sql.js": "^1.4.11",
    "express": "^4.21.2",
    "playwright": "^1.49.1",
    "sql.js": "^1.15.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "devDependencies": {}
}
